{
  "name": "quietsignal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": ["correlation"],
  "scripts": {
    "test": "bun test tests",
    "typecheck": "bun run --cwd correlation typecheck",
    "build": "bun run --cwd correlation build",
    "demo": "bun run scripts/demo.ts",
    "export:demo": "bun run scripts/export-demo.ts",
    "dev": "bun run scripts/server.ts",
    "simulate": "cre workflow simulate correlation --target local-simulation --non-interactive --trigger-index 0"
  },
  "devDependencies": {
    "@chainlink/cre-sdk-javy-plugin": "1.7.0"
  }
}
