{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "types": ["bun"],
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM"]
  },
  "include": ["app/**/*.ts", "scripts/*.ts", "demo/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests/workflow.test.ts"]
}
